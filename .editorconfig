# editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# PEP 8, and what ruff formats to
[*.py]
indent_size = 4

# markdown uses trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_size = 2

[*.{json,toml}]
indent_size = 2

# the artwork is authored as text and edited by hand
[*.svg]
indent_size = 2

# generated data: written by the harvester, not by a person
[data/**.json]
trim_trailing_whitespace = false
insert_final_newline = false
